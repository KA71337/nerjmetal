# ─── NERJ METAL · environment variables ──────────────────────────────────────
# Copy to .env.local for development. NEVER commit real values — only this
# placeholder file lives in Git; secrets go to Vercel → Settings → Env Vars.

# Admin panel password (login screen at /admin/login). Required.
ADMIN_PASSWORD=

# Long random string used to sign admin session cookies (openssl rand -base64 32).
SESSION_SECRET=

# GitHub Contents API persistence for src/data/products.json + uploaded photos.
# Token needs "Contents: read and write" on the repository only.
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=main
GITHUB_PRODUCTS_PATH=src/data/products.json

# Canonical production origin (metadata, sitemap, canonical, JSON-LD).
NEXT_PUBLIC_SITE_URL=https://nerjmetal.com
